# Copy to .env and adjust. Every field in app/config.py can be set here (upper-case name).

# --- LLM ---------------------------------------------------------------
# "ollama" = Ollama native API; "openai" = any OpenAI-compatible server
# (vLLM, llama.cpp llama-server, LM Studio, OpenAI, Groq ...). For "openai" the
# base URL must include /v1, e.g. http://localhost:8080/v1
LLM_BACKEND=ollama
LLM_BASE_URL=http://localhost:11434   # local runs only; docker-compose sets its own
LLM_MODEL=hf.co/unsloth/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M   # 4-bit; faster/less accurate: qwen3:1.7b-q4_K_M (see README)
# GPU (host Ollama, docker-compose.host-ollama.yml) default; also usable for local runs as LLM_MODEL:
LLM_MODEL_GPU=hf.co/unsloth/Qwen3-4B-Instruct-2507-GGUF:IQ4_XS
LLM_API_KEY=
LLM_NUM_THREAD=8            # Ollama CPU threads; 8 (= logical cores) was fastest on a 4C/8T laptop
LLM_THINK=false             # skip qwen3's reasoning phase (ignored by other models)

# --- knowledge -----------------------------------------------------------
KNOWLEDGE_MODE=rag          # rag | full (whole KB in the cached system prompt)
RAG_TOP_K=2
RAG_MIN_SCORE=0.45

# --- speech --------------------------------------------------------------
STT_MODEL=small             # tiny | base | small | medium | large-v3 ... (medium/large: also set STT_DYNAMIC_WINDOW=false, see README §4.4)
STT_DEVICE=cpu              # cuda on NVIDIA GPUs
STT_COMPUTE_TYPE=int8       # float16 on GPU
TTS_VOICE_TR=tr_TR-dfki-medium
TTS_VOICE_EN=en_US-ryan-medium

# --- turn-taking ---------------------------------------------------------
VAD_MIN_SILENCE_MS=500      # silence that ends the user's turn
BARGE_IN=true               # set false when using loudspeakers without echo cancellation

LOG_LEVEL=INFO
LOG_JSON=false
